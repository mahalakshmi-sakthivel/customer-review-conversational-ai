BCRYPT_STRENGTH=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# First-run only. Creates a SUPER_ADMIN if none exists. Remove after first start.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
